  "available_providers": {
    "notionai-openai-provider": {
      "description": "OpenAI-compatible HTTP adapter for NotionAI, allowing you to use NotionAI's unofficial API with any OpenAI-compatible client",
      "path": "notionai-openai-provider/",
      "features": [
        "OpenAI-compatible API (/v1/models, /v1/chat/completions)",
        "12+ model types mapped to NotionAI functions",
        "Local-only binding (127.0.0.1)",
        "API key authentication (bcrypt hashed)",
        "Rate limiting (100 req/min, burst 20)",
        "Docker support"
      ],
      "documentation": "notionai-openai-provider/README.md"
    }
  },

  "notionai_openai_provider": {
    "warning": "Uses Notion's unofficial internal API - may break if Notion changes their API",
    "security_risks": [
      "Not provided or supported by Notion",
      "May break if Notion changes their API",
      "Requires your personal token_v2 from browser DevTools",
      "Security risk if credentials are exposed",
      "Do NOT expose to public internet",
      "Run locally-only or behind strict authentication"
    ],
    "architecture": "CLIProxyAPI (or any OpenAI-compatible client) → OpenAI-compatible format → notionai-openai-provider (Go adapter) → NotionAI-go SDK → Notion unofficial API",
    "features": [
      "OpenAI-compatible API (/v1/models, /v1/chat/completions)",
      "12+ model types mapped to NotionAI functions",
      "Local-only binding (127.0.0.1)",
      "API key authentication (bcrypt hashed)",
      "Safe logging (no secrets)",
      "Rate limiting (100 req/min, burst 20)",
      "Fallback provider support",
      "Model aliases",
      "Docker support"
    ],
    "models": [
      {
        "model": "notion/help-me-draft",
        "description": "Generate content based on a prompt"
      },
      {
        "model": "notion/continue-writing",
        "description": "Continue writing from existing content"
      },
      {
        "model": "notion/help-me-edit",
        "description": "Optimize content based on a prompt"
      },
      {
        "model": "notion/translate-{lang}",
        "description": "Translate to target language (e.g., notion/translate-vietnamese)"
      },
      {
        "model": "notion/change-tone-{tone}",
        "description": "Change tone (e.g., notion/change-tone-professional)"
      },
      {
        "model": "notion/summarize",
        "description": "Summarize content"
      },
      {
        "model": "notion/improve-writing",
        "description": "Improve writing quality"
      },
      {
        "model": "notion/make-longer",
        "description": "Expand content"
      },
      {
        "model": "notion/make-shorter",
        "description": "Condense content"
      },
      {
        "model": "notion/explain",
        "description": "Explain complex content"
      },
      {
        "model": "notion/blog-post",
        "description": "Write a blog post"
      },
      {
        "model": "notion/chat",
        "description": "Generic chat"
      }
    ],
    "model_aliases": [
      "draft → notion/help-me-draft",
      "continue → notion/continue-writing",
      "edit → notion/help-me-edit",
      "translate → notion/translate-english",
      "summarize → notion/summarize",
      "chat → notion/chat"
    ],
    "api_endpoints": [
      {
        "endpoint": "/v1/models",
        "method": "GET",
        "purpose": "List models"
      },
      {
        "endpoint": "/v1/chat/completions",
        "method": "POST",
        "purpose": "Chat completion"
      }
    ],
    "quick_start": [
      "Get Notion Credentials (token_v2, spaceId, Notion-User-ID from browser DevTools)",
      "Clone NotionAI-go: cd pkg/upstream && git clone https://github.com/jyz0309/NotionAI-go.git notionai",
      "Configure: cp configs/config.example.yaml configs/config.yaml && cp .env.example .env",
      "Generate API key hash: htpasswd -nbB user \"your-password\" | cut -d: -f2",
      "Build: go build -o bin/notionai-adapter ./cmd/server",
      "Run: ./bin/notionai-adapter"
    ],
    "docker_support": {
      "setup": "Copy .env.example to .env and fill in credentials",
      "command": "docker-compose up -d"
    },
    "security_best_practices": [
      "Local-only binding: Server binds to 127.0.0.1:8080 only",
      "API key auth: All requests require valid API key",
      "Bcrypt hashing: API keys stored as bcrypt hashes",
      "Safe logging: No credentials or full prompts logged",
      "No public exposure: Never expose to internet",
      "Fallback support: Optional fallback to real LLM provider"
    ],
    "environment_variables": {
      "required": [
        "NOTION_TOKEN_V2",
        "NOTION_SPACE_ID",
        "NOTION_USER_ID",
        "NOTION_ADAPTER_KEY"
      ],
      "optional": [
        "FALLBACK_API_KEY"
      ]
    },
    "limitations": [
      "Unofficial API: Notion may break compatibility anytime",
      "No streaming: NotionAI doesn't support real streaming",
      "No token count: NotionAI doesn't provide token usage",
      "No function calling: NotionAI doesn't support tools/functions",
      "Rate limits: Subject to Notion's internal rate limits",
      "Authentication: Requires personal token_v2 (no official API keys)"
    ],
    "development": {
      "build": "go build -o bin/notionai-adapter ./cmd/server",
      "test": "go test ./...",
      "run_local": "./bin/notionai-adapter --config configs/config.yaml"
    },
    "configuration": {
      "config_yaml": {
        "notion": {
          "token_v2": "${NOTION_TOKEN_V2}",
          "space_id": "${NOTION_SPACE_ID}",
          "user_id": "${NOTION_USER_ID}"
        },
        "adapter": {
          "listen_addr": "127.0.0.1:8080",
          "api_key_hash": "$2a$10$...",
          "enable_fallback": false
        },
        "fallback": {
          "provider": "openai",
          "base_url": "https://api.openai.com/v1",
          "api_key": "${FALLBACK_API_KEY}"
        }
      }
    },
    "integration_with_cliproxyapi": {
      "config_yaml": {
        "providers": {
          "notion-adapter": {
            "type": "openai-compatible",
            "base_url": "http://127.0.0.1:8080/v1",
            "api_key": "${NOTION_ADAPTER_KEY}",
            "models": [
              "notion/help-me-draft",
              "notion/continue-writing",
              "notion/help-me-edit",
              "notion/translate-vietnamese",
              "notion/change-tone-professional",
              "notion/summarize",
              "notion/chat"
            ]
          }
        }
      }
    },
    "license": "MIT License",
    "acknowledgments": [
      "NotionAI-go - Go SDK for NotionAI",
      "notionai-py - Python SDK for NotionAI (reference)"
    ]
  },

