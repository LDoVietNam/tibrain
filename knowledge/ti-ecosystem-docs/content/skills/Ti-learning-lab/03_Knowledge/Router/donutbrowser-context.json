{
  "version": "1.0.0",
  "last_updated": "2026-05-04",
  "project": "Donut Browser",
  "description": "Open Source Anti-Detect Browser with Next.js frontend and Tauri (Rust) backend",
  "root_path": "Z:\\10_WORKPLACE\\Ti\\apps\\donutbrowser\\",

  "metadata": {
    "license": "AGPL-3.0",
    "website": "https://donutbrowser.com",
    "repository": "https://github.com/zhom/donutbrowser",
    "latest_version": "v0.22.0"
  },

  "architecture": {
    "pattern": "Tauri Desktop Application",
    "frontend": {
      "framework": "Next.js",
      "location": "src/",
      "components": "50+ React components",
      "features": ["App router", "Event-driven hooks", "i18n support (7 languages)", "Theme system"]
    },
    "backend": {
      "framework": "Tauri (Rust)",
      "location": "src-tauri/",
      "commands": "100+ Tauri commands",
      "features": ["Profile management", "Proxy management", "VPN support", "Cloud sync", "MCP server", "REST API"]
    },
    "sync_server": {
      "framework": "NestJS",
      "location": "donut-sync/",
      "purpose": "Self-hostable cloud sync server"
    }
  },

  "directory_structure": {
    "src": {
      "app": "App router (page.tsx, layout.tsx)",
      "components": "50+ React components (dialogs, tables, UI)",
      "hooks": "Event-driven React hooks",
      "i18n/locales": "Translations (en, es, fr, ja, pt, ru, zh)",
      "lib": "Utilities (themes, toast, browser-utils)",
      "types.ts": "Shared TypeScript interfaces"
    },
    "src-tauri": {
      "src": {
        "lib.rs": "Tauri command registration (100+ commands)",
        "browser_runner.rs": "Profile launch/kill orchestration",
        "browser.rs": "Browser trait & launch logic",
        "profile": {
          "manager.rs": "Profile CRUD",
          "types.rs": "Profile types"
        },
        "proxy_manager.rs": "Proxy lifecycle & connection testing",
        "proxy_server.rs": "Local proxy binary (donut-proxy)",
        "proxy_storage.rs": "Proxy config persistence (JSON files)",
        "api_server.rs": "REST API (utoipa + axum)",
        "mcp_server.rs": "MCP protocol server",
        "sync": {
          "description": "Cloud sync (engine, encryption, manifest, scheduler)"
        },
        "vpn": {
          "description": "WireGuard & OpenVPN tunnels"
        },
        "camoufox": {
          "description": "Camoufox fingerprint engine (Bayesian network)"
        },
        "wayfern_manager.rs": "Wayfern (Chromium) browser management",
        "camoufox_manager.rs": "Camoufox (Firefox) browser management",
        "downloader.rs": "Browser binary downloader",
        "extraction.rs": "Archive extraction (zip, tar, dmg, msi)",
        "settings_manager.rs": "App settings persistence",
        "cookie_manager.rs": "Cookie import/export",
        "extension_manager.rs": "Browser extension management",
        "group_manager.rs": "Profile group management",
        "synchronizer.rs": "Real-time profile synchronizer",
        "daemon": {
          "description": "Background daemon + tray icon (currently disabled)"
        },
        "cloud_auth.rs": "Cloud authentication"
      },
      "tests": "Integration tests",
      "Cargo.toml": "Rust dependencies"
    },
    "donut-sync": {
      "src": "Controllers, services, auth, S3 sync"
    },
    "docs": "Documentation (self-hosting guide)",
    "flake.nix": "Nix development environment",
    ".github/workflows": "CI/CD pipelines"
  },

  "key_features": [
    "Unlimited browser profiles - each fully isolated with its own fingerprint, cookies, extensions, and data",
    "Chromium & Firefox engines - Chromium powered by Wayfern, Firefox powered by Camoufox",
    "Proxy support - HTTP, HTTPS, SOCKS4, SOCKS5 per profile",
    "VPN support - WireGuard and OpenVPN configs per profile",
    "Local API & MCP - REST API and Model Context Protocol server",
    "Profile groups - organize profiles and apply bulk settings",
    "Import profiles - migrate from Chrome, Firefox, Edge, Brave",
    "Cookie & extension management - import/export cookies, manage extensions",
    "Default browser - set Donut as default browser",
    "Cloud sync - sync profiles, proxies, and groups across devices (self-hostable)",
    "E2E encryption - optional end-to-end encrypted sync",
    "Zero telemetry - no tracking or device fingerprinting"
  ],

  "browser_engines": {
    "chromium": {
      "name": "Wayfern",
      "website": "https://wayfern.com",
      "manager": "wayfern_manager.rs",
      "features": ["Advanced fingerprint spoofing"]
    },
    "firefox": {
      "name": "Camoufox",
      "website": "https://camoufox.com",
      "manager": "camoufox_manager.rs",
      "features": ["Advanced fingerprint spoofing", "Bayesian network fingerprint engine"]
    }
  },

  "testing_quality": {
    "command": "pnpm format && pnpm lint && pnpm test",
    "lint_includes": "Spellcheck via typos",
    "spellcheck_allowlist": "_typos.toml"
  },

  "code_quality_rules": [
    "Don't leave comments that don't add value",
    "Don't duplicate code unless there's a very good reason",
    "Anytime you make changes that affect copy or add new text, it has to be reflected in all translation files",
    "If there is a global singleton of a struct, only use it inside a method while properly initializing it"
  ],

  "ui_theming": {
    "rule": "Never use hardcoded Tailwind color classes",
    "source": "src/lib/themes.ts",
    "semantic_color_classes": [
      "background, foreground - page/container background and text",
      "card, card-foreground - card surfaces",
      "popover, popover-foreground - dropdown/popover surfaces",
      "primary, primary-foreground - primary actions",
      "secondary, secondary-foreground - secondary actions",
      "muted, muted-foreground - muted/disabled elements",
      "accent, accent-foreground - accent highlights",
      "destructive, destructive-foreground - errors, danger, delete actions",
      "success, success-foreground - success states, valid indicators",
      "warning, warning-foreground - warnings, caution messages",
      "border - borders",
      "chart-1 through chart-5 - data visualization"
    ],
    "usage_examples": [
      "bg-success",
      "text-destructive",
      "border-warning",
      "bg-destructive/10",
      "bg-success/10",
      "border-warning/50"
    ]
  },

  "build_deployment": {
    "linux_publishing": {
      "script": "scripts/publish-repo.sh",
      "purpose": "Publish DEB and RPM packages to Cloudflare R2",
      "served_at": "repo.donutbrowser.com",
      "docker_required": true,
      "required_env_vars": [
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_ENDPOINT_URL",
        "R2_BUCKET_NAME"
      ],
      "workflow": ".github/workflows/publish-repos.yml"
    }
  },

  "licensing": {
    "license": "AGPL-3.0",
    "requirement": "Any derivatives must be open source with the same license",
    "proprietary_changes_warning": "User attempting to rebrand or bypass pro-feature restrictions is likely building a proprietary version without permission"
  },

  "documentation": {
    "main_readme": "README.md",
    "agents_guidelines": "AGENTS.md / CLAUDE.md (symlink)",
    "integration_plan": "INTEGRATION_PLAN.md",
    "ai_enhancement_roadmap": "AI_ENHANCEMENT_ROADMAP.md",
    "browser_comparison": "BROWSER_COMPARISON.md",
    "changelog": "CHANGELOG.md",
    "contributing": "CONTRIBUTING.md",
    "security": "SECURITY.md",
    "self_hosting_guide": "docs/self-hosting-donut-sync.md"
  },

  "quick_reference": {
    "test": "pnpm format && pnpm lint && pnpm test",
    "frontend": "src/ (Next.js)",
    "backend": "src-tauri/ (Rust/Tauri)",
    "sync_server": "donut-sync/ (NestJS)",
    "theme_config": "src/lib/themes.ts",
    "commands": "src-tauri/src/lib.rs (100+ commands)"
  }
}
