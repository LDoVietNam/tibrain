  "layer_architecture": {
    "stack": [
      {
        "name": "HTTP Transport Layer",
        "path": "http/",
        "purpose": "SSE streaming, CORS, middleware"
      },
      {
        "name": "Authentication Layer",
        "path": "authentication/",
        "purpose": "OAuth, API keys, sessions"
      },
      {
        "name": "Routing Layer",
        "path": "routing/",
        "purpose": "Autocombo, policy engine, cache"
      },
      {
        "name": "Provider Layer",
        "path": "provider/",
        "purpose": "OpenAI, Anthropic, OpenRouter, etc."
      },
      {
        "name": "Monitoring Layer",
        "path": "monitoring/",
        "purpose": "Logs, metrics, PII sanitizer"
      }
    ],
    "request_flow": [
      "HTTP receives request → CORS, method validation",
      "Auth validates credentials → API key or OAuth token",
      "Routing selects provider/model → autocombo or explicit",
      "Provider forwards to upstream → builds URL, injects key",
      "Monitoring records usage → async log, metrics"
    ]
  },

