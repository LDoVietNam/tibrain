  "key_features": {
    "api_compatibility": "OpenAI-compatible API surface for CLI/tools (28 providers)",
    "translation": "Request/response translation across provider formats",
    "fallback": "Model combo fallback (multi-model sequence), account-level fallback",
    "authentication": "OAuth + API-key provider connection management",
    "embeddings": "Embedding generation via /v1/embeddings (6 providers, 9 models)",
    "images": "Image generation via /v1/images/generations (4 providers, 9 models)",
    "thinking": "Think tag parsing for reasoning models",
    "sanitization": "Response sanitization for strict OpenAI SDK compatibility",
    "role_normalization": "Role normalization (developer→system, system→user)",
    "structured_output": "Structured output conversion (json_schema→Gemini responseSchema)",
    "persistence": "Local persistence for providers, keys, aliases, combos, settings, pricing",
    "tracking": "Usage/cost tracking and request logging",
    "cloud_sync": "Optional cloud sync for multi-device/state sync",
    "access_control": "IP allowlist/blocklist for API access control",
    "thinking_budget": "Thinking budget management (passthrough/auto/custom/adaptive)",
    "system_prompt": "Global system prompt injection",
    "session_tracking": "Session tracking and fingerprinting",
    "rate_limiting": "Per-account enhanced rate limiting with provider-specific profiles",
    "circuit_breaker": "Circuit breaker pattern for provider resilience",
    "anti_thundering": "Anti-thundering herd protection with mutex locking",
    "deduplication": "Signature-based request deduplication cache",
    "domain_layer": "Model availability, cost rules, fallback policy, lockout policy",
    "domain_state": "Domain state persistence (SQLite write-through cache)",
    "policy_engine": "Policy engine for centralized request evaluation",
    "telemetry": "Request telemetry with p50/p95/p99 latency aggregation",
    "correlation_id": "Correlation ID (X-Request-Id) for end-to-end tracing",
    "audit_logging": "Compliance audit logging with opt-out per API key",
    "eval_framework": "Eval framework for LLM quality assurance",
    "resilience_ui": "Resilience UI dashboard with real-time circuit breaker status",
    "oauth_modules": "Modular OAuth providers (12 individual modules)"
  },

  "runtime_model": {
    "app_routes": "Next.js app routes under src/app/api/* implement both dashboard APIs and compatibility APIs",
    "sse_core": "Shared SSE/routing core in src/sse/* + open-sse/* handles provider execution, translation, streaming, fallback, and usage"
  },

