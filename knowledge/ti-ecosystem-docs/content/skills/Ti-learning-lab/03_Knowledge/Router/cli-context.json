  "entry_point": {
    "file": "cmd/root.go",
    "main_command": {
      "use": "ti",
      "aliases": ["ti-cli"],
      "short": "Ti CLI - AI agent ecosystem runtime",
      "version": "3.0.0-ti-ecosystem-go1.23",
      "args": "cobra.ArbitraryArgs",
      "run": "runRootNaturalLanguage"
    },
    "global_flags": [
      "--config, -c: config file (default is $HOME/.ti-cli/config.yaml)",
      "--log-level, -l: log level (debug, info, warn, error) (overrides config)"
    ],
    "persistent_pre_run": [
      "Load configuration",
      "Initialize Router service",
      "Start Router service"
    ],
    "persistent_post_run": [
      "Stop Router service"
    ],
    "initialization_sequence": [
      "Setup signal handler for graceful shutdown",
      "Initialize plugin host",
      "Attach capability commands",
      "Execute root command",
      "Shutdown"
    ]
  },

  "commands": {
    "easy_intent_commands": [
      {
        "command": "ti fix",
        "aliases": ["ti sua"],
        "purpose": "Fix issues",
        "safety": "Plan-only by default, add --run to execute safe steps"
      },
      {
        "command": "ti plan",
        "aliases": ["ti ke-hoach"],
        "purpose": "Plan tasks",
        "example": "ti plan \"provider fallback\""
      },
      {
        "command": "ti review",
        "aliases": ["ti danh-gia"],
        "purpose": "Review code"
      },
      {
        "command": "ti optimize",
        "aliases": ["ti toi-uu"],
        "purpose": "Optimize code/context/cli",
        "example": "ti optimize context"
      },
      {
        "command": "ti backup",
        "aliases": ["ti sao-luu"],
        "purpose": "Backup",
        "example": "ti backup --run"
      },
      {
        "command": "ti handoff",
        "aliases": ["ti ban-giao"],
        "purpose": "Handoff tasks",
        "example": "ti handoff \"continue with reviewer\" --run --yes"
      },
      {
        "command": "ti create-workflow",
        "aliases": ["ti tao-workflow"],
        "purpose": "Create workflow",
        "example": "ti create-workflow \"review test fix handoff\" --run --yes"
      },
      {
        "command": "ti create-skill",
        "aliases": ["ti tao-skill"],
        "purpose": "Create skill",
        "example": "ti create-skill \"secure go api review\" --run --yes"
      },
      {
        "command": "ti load-skill",
        "aliases": ["ti nap-skill"],
        "purpose": "Load skill from folder",
        "example": "ti load-skill ./my-skills --run --yes"
      },
      {
        "command": "ti expert",
        "purpose": "Expert mode",
        "example": "ti expert go \"review secure error handling\""
      }
    ],
    "ecosystem_commands": [
      "ti doctor",
      "ti config init",
      "ti config show",
      "ti config validate",
      "ti registry init",
      "ti registry add skill .ti/skills/go-secure-error-handling",
      "ti manifest init",
      "ti manifest validate",
      "ti context scan",
      "ti context pack \"review provider router\"",
      "ti permission init",
      "ti permission check -- git status",
      "ti audit log \"started review\"",
      "ti audit tail"
