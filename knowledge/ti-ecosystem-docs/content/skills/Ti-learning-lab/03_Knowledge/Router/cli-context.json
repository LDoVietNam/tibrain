  "architecture_pattern": {
    "name": "Microkernel + Plugin",
    "similar_systems": [
      "VS Code - Extension system",
      "Eclipse - Plugin architecture",
      "IntelliJ IDEA - Plugin ecosystem"
    ],
    "components": [
      {
        "name": "Agent Manager",
        "purpose": "Plugin Loader & Lifecycle",
        "features": ["Discovery", "Loading", "Health Check", "Lifecycle management", "Decision logic"]
      },
      {
        "name": "Plugin Bus",
        "purpose": "gRPC + Streaming",
        "features": ["Type-safe interfaces (protobuf)", "Bidirectional streaming", "Error handling & retries", "Connection pooling"]
      },
      {
        "name": "Plugin Registry",
        "purpose": "Plugin metadata management",
        "features": ["Plugin metadata", "Version management", "Dependency resolution"]
      },
      {
        "name": "Health Monitor",
        "purpose": "Plugin health monitoring",
        "features": ["Plugin health checks", "Auto-restart unhealthy plugins", "Graceful degradation"]
      }
    ],
    "plugins": [
      {
        "name": "Devin Plugin",
        "language": "Python+gRPC",
        "features": 17,
        "characteristics": ["Auto-update", "Process isolation"]
      },
      {
        "name": "Native Plugins",
        "language": "Go",
        "characteristics": ["Critical path only", "High performance"]
      },
      {
        "name": "Future Plugins",
        "examples": ["Claude", "Cursor", "Custom agents"]
      }
    ]
  },

