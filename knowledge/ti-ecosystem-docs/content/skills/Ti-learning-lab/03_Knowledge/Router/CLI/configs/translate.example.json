{
  "translate": {
    "max_depth": 10,
    "default_target": "ti-pack",
    "strict": false,
    "sandbox_executable_imports": true,
    "scan": {
      "skip_dirs": [".git", "node_modules", "vendor", "dist", "build", "target"]
    },
    "exports": {
      "claude-code": ["CLAUDE.md", ".claude/commands", ".claude/agents"],
      "codex": ["AGENTS.md"],
      "opencode": [".opencode/commands", ".opencode/agents", ".opencode/skills"]
    }
  }
}
