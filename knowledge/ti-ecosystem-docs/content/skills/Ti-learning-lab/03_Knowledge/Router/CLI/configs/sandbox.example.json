{
  "enabled": true,
  "backend": "auto",
  "fallback": "portable",
  "network": "deny",
  "timeout_seconds": 120,
  "max_output_bytes": 200000,
  "read_allow": ["./"],
  "write_allow": ["./", "./tmp"],
  "path_deny": [
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*",
    "~/.ssh/**",
    "~/.config/**",
    "~/.aws/**",
    "~/.gnupg/**",
    ".git/**",
    "node_modules/**"
  ],
  "env_allow": [
    "PATH",
    "HOME",
    "USER",
    "USERNAME",
    "SHELL",
    "TMPDIR",
    "TEMP",
    "TMP",
    "GOCACHE",
    "GOMODCACHE",
    "GOTOOLCHAIN",
    "GOWORK",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY"
  ],
  "command_deny": [
    "rm -rf /",
    "rm -rf .",
    "rm -rf *",
    "del /s",
    "format ",
    "mkfs",
    "dd if=",
    "shutdown",
    "reboot",
    "poweroff",
    ":(){",
    "fork bomb",
    "chmod -R 777 /",
    "chown -R"
  ],
  "audit_file": "~/.ti/data/sandbox/audit.jsonl"
}
