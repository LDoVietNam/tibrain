  "go_modules": {
    "main": {
      "module": "github.com/ti/automation",
      "path": "go.mod",
      "dependencies": [],
      "indirect_dependencies": []
    }
  },

  "directory_structure": {
    "root": {
      "main.go": "Entry point for automation CLI",
      "plugin.go": "Plugin interface and types",
      "registry.go": "Plugin registry implementation",
      "loader.go": "Plugin loader",
      "doctor.go": "Doctor automation plugin",
      "knowledge-sync.go": "Knowledge sync automation plugin",
      "knowledge-sync-ai.go": "Knowledge sync with AI automation plugin",
      "router.go": "Router automation plugin",
      "snapshot.go": "Snapshot automation plugin",
      "llm": {
        "client.go": "LLM client for AI-powered automation"
      }
    }
  },

  "architecture": {
    "pattern": "Plugin Registry System",
    "components": [
      {
        "name": "Plugin Registry",
        "file": "registry.go",
        "purpose": "Manage plugin lifecycle and discovery"
      },
      {
        "name": "Plugin Loader",
        "file": "loader.go",
        "purpose": "Load built-in and external plugins"
      },
      {
        "name": "Plugin Interface",
        "file": "plugin.go",
        "purpose": "Define plugin contract and types"
      }
    ],
    "built_in_plugins": [
      {
        "name": "doctor",
        "file": "doctor.go",
        "description": "Doctor automation plugin"
      },
      {
        "name": "knowledge-sync",
        "file": "knowledge-sync.go",
        "description": "Knowledge sync automation plugin"
      },
      {
        "name": "knowledge-sync-ai",
        "file": "knowledge-sync-ai.go",
        "description": "Knowledge sync with AI automation plugin"
      },
      {
        "name": "router",
        "file": "router.go",
        "description": "Router automation plugin"
      },
      {
        "name": "snapshot",
        "file": "snapshot.go",
        "description": "Snapshot automation plugin"
      }
    ]
  },

  "plugin_interface": {
    "automation_plugin": {
      "methods": [
        "Name() string",
        "Version() string",
        "Description() string",
        "Commands() []AutomationCommand",
        "Execute(ctx context.Context, cmd string, args []string, pluginCtx PluginContext) (*PluginResult, error)",
        "Initialize(pluginCtx PluginContext) error",
        "Cleanup() error"
      ]
    },
    "automation_command": {
      "fields": [
        "Name",
        "Description",
        "Usage",
        "Flags",
        "Category"
      ],
      "categories": ["dev", "ai", "mcp", "router"]
    },
    "plugin_context": {
      "fields": [
        "WorkingDir",
        "Config",
        "Env",
        "Logger"
      ]
    },
    "plugin_result": {
      "fields": [
        "Success",
        "Message",
        "Output",
        "Error",
        "Metadata",
        "ExitCode"
      ]
    }
  },

  "entry_point": {
    "file": "main.go",
    "flow": [
      "Create plugin registry",
      "Create built-in plugins loader",
      "Load all plugins",
      "List loaded plugins",
      "List available commands",
      "Execute command if args provided",
      "Show usage if no args"
    ],
    "usage": "go run . <command> [args]"
  },

  "build_deployment": {
    "build_command": "cd apps/automation && go build -o ../../bin/automation.exe .",
    "run_command": "./bin/automation.exe <command> [args]",
    "test_command": "go test ./..."
  },

  "key_features": [
    "Plugin registry system",
    "Built-in automation plugins",
    "Extensible plugin architecture",
    "Command execution framework",
    "Plugin context management",
    "Logger interface"
  ],

  "quick_reference": {
    "build": "cd apps/automation && go build -o ../../bin/automation.exe .",
    "run": "./bin/automation.exe <command> [args]",
    "main_file": "main.go",
    "plugin_interface": "plugin.go",
    "registry": "registry.go"
  }
}
