{
  "version": "1.0.0",
  "last_updated": "2026-05-04",
  "project": "Ti Dashboard",
  "description": "Web dashboard for Ti ecosystem with embedded templates and static files",
  "root_path": "Z:\\10_WORKPLACE\\Ti\\apps\\dashboard\\",

  "metadata": {
    "language": "Go",
    "go_version": "1.24",
    "main_module": "github.com/ti/dashboard",
    "default_port": "3001",
    "default_api_url": "http://localhost:1807"
  },

  "go_modules": {
    "main": {
      "module": "github.com/ti/dashboard",
      "path": "go.mod",
      "dependencies": [],
      "indirect_dependencies": []
    }
  },

  "directory_structure": {
    "root": {
      "main.go": "Entry point and HTTP server",
      "templates": "HTML templates (embedded)",
      "static": "Static assets (CSS, JS, images) (embedded)"
    }
  },

  "architecture": {
    "pattern": "Embedded Web Server",
    "components": [
      {
        "name": "DashboardServer",
        "purpose": "HTTP server with template rendering",
        "fields": [
          "tmpl - Template engine",
          "apiURL - Ti Router API URL",
          "apiToken - Authentication token"
        ]
      },
      {
        "name": "Embedded Assets",
        "purpose": "Templates and static files embedded in binary",
        "directive": "//go:embed templates/*, static/*"
      },
      {
        "name": "HTTP Routes",
        "purpose": "Page handlers and API endpoints"
      }
    ]
  },

  "data_models": {
    "account": {
      "fields": [
        "Email",
        "UserID",
        "SpaceID",
        "TokenV2",
        "Plan",
        "Status",
        "LastUsed",
        "QuotaUsed",
        "QuotaTotal"
      ],
      "source": "Notion accounts via Ti Router API"
    },
    "proxy": {
      "fields": [
        "ID",
        "Name",
        "Type",
        "Host",
        "Port",
        "Status",
        "LastUsed"
      ],
      "source": "Router providers or mock data"
    },
    "domain": {
      "fields": [
        "ID",
        "Verified",
        "IsDefault",
        "Services",
        "AuthType",
        "Users"
      ],
      "source": "Microsoft 365 domains (mock data)"
    }
  },

  "http_routes": {
    "pages": [
      {
        "route": "/",
        "handler": "handleIndex",
        "template": "index.html"
      },
      {
        "route": "/accounts",
        "handler": "handleAccounts",
        "template": "accounts.html"
      },
      {
        "route": "/domains",
        "handler": "handleDomains",
        "template": "domains.html"
      },
      {
        "route": "/proxies",
        "handler": "handleProxies",
        "template": "proxies.html"
      }
    ],
    "api_endpoints": [
      {
        "route": "/api/accounts",
        "handler": "apiAccounts",
        "method": "GET"
      },
      {
        "route": "/api/domains",
        "handler": "apiDomains",
        "method": "GET"
      },
      {
        "route": "/api/proxies",
        "handler": "apiProxies",
        "method": "GET"
      },
      {
        "route": "/api/health",
        "handler": "apiHealth",
        "method": "GET"
      }
    ],
    "static_files": {
      "route": "/static/",
        "handler": "http.FileServer(http.FS(assets))"
    }
  },

  "api_integration": {
    "ti_router": {
      "default_url": "http://localhost:1807",
      "env_variable": "TI_API_URL",
      "endpoints": [
        "/api/notion - Fetch Notion accounts",
        "/api/providers - Fetch provider information",
        "/api/health - Health check"
      ],
      "authentication": "Bearer token via TI_API_TOKEN env variable",
      "timeout": "10 seconds",
      "fallback": "Mock data when API unavailable"
    }
  },

  "environment_variables": {
    "PORT": "Server port (default: 3001)",
    "TI_API_URL": "Ti Router API URL (default: http://localhost:1807)",
    "TI_API_TOKEN": "Authentication token for Ti Router API"
  },

  "entry_point": {
    "file": "main.go",
    "flow": [
      "Read environment variables (PORT, TI_API_URL, TI_API_TOKEN)",
      "Create DashboardServer instance",
      "Parse embedded templates",
      "Setup HTTP routes",
      "Start HTTP server"
    ]
  },

  "build_deployment": {
    "build_command": "cd apps/dashboard && go build -o ../../bin/dashboard.exe .",
    "run_command": "./bin/dashboard.exe",
    "run_with_custom_port": "PORT=3002 ./bin/dashboard.exe",
    "run_with_custom_api": "TI_API_URL=http://localhost:1808 ./bin/dashboard.exe",
    "test_command": "go test ./..."
  },

  "key_features": [
    "Embedded templates and static files",
    "Integration with Ti Router API",
    "Account management (Notion)",
    "Domain management (Microsoft 365)",
    "Proxy/Provider management",
    "Health check endpoint",
    "Fallback to mock data",
    "Responsive web interface"
  ],

  "quick_reference": {
    "build": "cd apps/dashboard && go build -o ../../bin/dashboard.exe .",
    "run": "./bin/dashboard.exe",
    "access": "http://localhost:3001",
    "main_file": "main.go",
    "templates": "templates/",
    "static": "static/"
  }
}
